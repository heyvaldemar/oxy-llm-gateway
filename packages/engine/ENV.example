# ============================================================================
# OXY ENGINE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure with your actual values
# 
# CRITICAL: Never commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (Supabase)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here  # Service role (NOT anon key!)
SUPABASE_DB_PASSWORD=your-database-password

# Optional: Database connection overrides (for setup-supabase.sh)
# Only needed if auto-detection fails or you're using custom networking
# DB_HOST=db.your-project.supabase.co
# DB_PORT=6543  # Use 6543 for Connection Pooler, 5432 for direct

# ----------------------------------------------------------------------------
# CACHE & RATE LIMITING (Redis)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password-here  # Optional for local dev, REQUIRED for production

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
ENVIRONMENT=development  # Options: development, production
ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated for multiple
# CRITICAL: Include 'engine' for Docker inter-container communication
ALLOWED_HOSTS=localhost,127.0.0.1,engine
SECRET_KEY=your-secret-key-min-32-chars  # Generate: openssl rand -hex 32
# An Oxy API key for scripts/dev_smoke.sh: create one in the dashboard (nothing is seeded).
OXY_API_KEY=

# ----------------------------------------------------------------------------
# BILLING (Stripe) - Optional
# ----------------------------------------------------------------------------
# Leave these unset to run without Stripe: the Stripe endpoints answer 503 and
# plan tiers are assigned by the operator in the database.
STRIPE_SECRET_KEY=sk_test_your-key-here  # Use sk_live_ for production
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here  # Get from Stripe webhook settings

# Stripe Price IDs (only needed when Stripe is enabled)
# Create one price per plan tier in: Stripe Dashboard → Products → Add Product → Pricing
# Then copy the price IDs (format: price_xxxxxxxxxxxxx). Amounts are set in Stripe.
# Plan names match packages/ui/src/app/pricing/page.tsx (plan limits page).

# Monthly Plans
STRIPE_PRICE_ID_STARTER=price_your_starter_id_here      # starter tier (500K requests)
STRIPE_PRICE_ID_GROWTH=price_your_growth_id_here        # growth tier (2M requests)
STRIPE_PRICE_ID_BUSINESS=price_your_business_id_here    # business tier (10M requests)
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_id_here # enterprise tier (no request cap)

# Annual Plans
STRIPE_PRICE_ID_STARTER_YEARLY=price_your_starter_yearly_id_here
STRIPE_PRICE_ID_GROWTH_YEARLY=price_your_growth_yearly_id_here
STRIPE_PRICE_ID_BUSINESS_YEARLY=price_your_business_yearly_id_here
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_your_enterprise_yearly_id_here

STRIPE_USAGE_PRICE_ID=price_your_usage_metered_id_here  # Optional: metered price for usage above the enterprise baseline
# ENTERPRISE_INCLUDED_TOKENS=10000000  # Tokens per month included before metered usage is reported
# USAGE_UNIT_PRICE_USD=0               # Informational: amount of STRIPE_USAGE_PRICE_ID per 1K tokens, for logs only

# ----------------------------------------------------------------------------
# EMAIL (Resend API) - CRITICAL for Budget Alerts & Team Invites
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your-api-key-here  # Get at: https://resend.com/api-keys
EMAIL_ENABLED=true  # Set to false to disable email sending
EMAIL_FROM=alerts@example.com  # Your verified sender email
# SUPPORT_EMAIL=support@example.com  # Shown in payment-failed emails
# SITE_URL=http://localhost:3000     # Public URL of the UI, used in invite, referral and email links

# Legacy: SendGrid (deprecated, use Resend)
# SENDGRID_API_KEY=SG.your-api-key-here

# ----------------------------------------------------------------------------
# MONITORING (Sentry) - Optional but Recommended
# ----------------------------------------------------------------------------
SENTRY_DSN=https://your-dsn@sentry.io/project  # Optional

# ----------------------------------------------------------------------------
# METRICS SECURITY (Prometheus) - CRITICAL for Production
# ----------------------------------------------------------------------------
METRICS_USER=admin  # Username for /metrics endpoint
METRICS_PASSWORD=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING  # Generate: openssl rand -base64 48

# ----------------------------------------------------------------------------
# AI PROVIDERS (Optional - Users connect via UI)
# ----------------------------------------------------------------------------
# These are optional. Users typically connect their own keys via the dashboard.
# Only set these if you want to use organization-wide keys.
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_API_BASE=https://api.openai.com/v1  # Override if using a proxy/self-hosted
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=AIza-your-key-here  # For Gemini access
# Local models (no provider key needed): vllm/<name>, ollama/<name>, local/<name>
# VLLM_BASE_URL=http://localhost:8000
# OLLAMA_BASE_URL=http://localhost:11434
# LOCAL_HTTP_BASE_URL=http://localhost:8000  # local/<name>: any OpenAI-compatible server
# VLLM_API_KEY=  # only if the server was started with its own key (vLLM --api-key); OLLAMA_API_KEY, LOCAL_API_KEY likewise
# LOCAL_PROMPT_PRICE_PER_MILLION=0  # USD per million tokens a local model costs you; 0 bills nothing
# LOCAL_COMPLETION_PRICE_PER_MILLION=0

# ----------------------------------------------------------------------------
# RATE LIMITING (Optional - Defaults are sensible)
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60  # Per API key (default: 60)
RATE_LIMIT_MANAGEMENT_PER_MINUTE=30  # Per user for /management endpoints (default: 30)

